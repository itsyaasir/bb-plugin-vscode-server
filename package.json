{
  "name": "bb-plugin-vscode-server",
  "version": "0.1.18",
  "type": "module",
  "description": "Embeds a configured code-server or VS Code Server instance in BB right-panel tabs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GantisStorm/bb-plugin-vscode-server.git"
  },
  "bugs": {
    "url": "https://github.com/GantisStorm/bb-plugin-vscode-server/issues"
  },
  "homepage": "https://github.com/GantisStorm/bb-plugin-vscode-server#readme",
  "engines": {
    "bb": ">=0.41",
    "bbPluginSdk": ">=0.4.35"
  },
  "bb": {
    "name": "VS Code Server",
